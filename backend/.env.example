# Copy to .env and fill in. Only PORT / ENV / DB_PATH have local defaults;
# the rest must be set explicitly for any non-development run.

# HTTP listen port. Default: 8080
PORT=8080

# development | production. In production the server REFUSES to start without
# a valid MASTER_KEY, and localhost origins are NOT auto-allowed.
ENV=development

# Comma-separated list of allowed CORS origins (no trailing slashes).
# In development, http://localhost:5173, :5174, and :8080 are added automatically.
ALLOWED_ORIGINS=http://localhost:5173

# VITE_API_BASE, e.g. https://api.example.com/api/v1
# Feeds the CSP connect-src header. Default: http://localhost:8080
VITE_API_BASE=http://localhost:8080

# Set to true only when the server sits behind a trusted reverse proxy that
# sets X-Forwarded-For. Enables chi middleware.RealIP for rate limiting.
TRUST_PROXY=false

# Shared secret that unlocks admin endpoints (/admin/telemetry, /admin/purge,
# /admin/login). BACKEND-ONLY — never put this in a frontend .env file.
# Super-admin endpoints return 401 when this is unset.
SUPER_ADMIN_KEY=

# Path to the SQLite database file. Default: nullsecret.db
DB_PATH=nullsecret.db

# Directory for VACUUM INTO backups. Default: .
BACKUP_DIR=./backups

# 32 bytes as 64 hex chars, e.g. 00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
# Used for AES-256-GCM encryption of secrets at rest. REQUIRED in production:
# a missing/invalid key makes stored secrets unrecoverable after restart, so the
# server exits(1) in production rather than silently degrade.
# Generate with: openssl rand -hex 32
MASTER_KEY=
